# Database
DATABASE_URL="postgresql://user:password@localhost:5432/undangan_digital?schema=public"

# NextAuth v5
AUTH_SECRET="ganti_dengan_secret_random_minimal_32_karakter"
# NEXTAUTH_URL="https://domain-anda.com"

# Cloudflare R2 (upload foto — wajib diisi untuk production)
# Buat bucket di Cloudflare R2, dapatkan credentials dari dashboard R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Upstash Redis (rate limiting — opsional, fallback tanpa limit saat kosong)
# Daftar gratis di upstash.com, buat database Redis, dapatkan URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
