# Database
DATABASE_URL="postgresql://user:password@localhost:5432/undangan_digital?schema=public"

# NextAuth v5
AUTH_SECRET="ganti_dengan_secret_random_minimal_32_karakter"
# NEXTAUTH_URL="https://domain-anda.com"

# Cloudinary (upload foto — wajib diisi untuk production)
# Daftar gratis di cloudinary.com, dapatkan cloud name, API key, API secret
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis (rate limiting — fallback tanpa limit saat kosong)
# Daftar gratis di upstash.com, buat database Redis, dapatkan URL + token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
